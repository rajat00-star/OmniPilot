# OmniPilot server configuration. Copy to .env and fill in. Never commit .env.

# Optional. When unset, OmniPilot runs in transparent deterministic mode
# (real browser collection + rule-based analysis, no AI reasoning).
ANTHROPIC_API_KEY=

# Model used for planning and evidence-grounded synthesis.
ANTHROPIC_MODEL=claude-opus-5-5

# Server port (the Vite dev server proxies /api here).
PORT=8787

# Set to 1 to run Chromium with a visible window (enables manual takeover on desktop).
OMNIPILOT_HEADED=0

# Where missions, captured sources, screenshots and artifacts are stored.
OMNIPILOT_DATA_DIR=./data

# Per-navigation timeout in milliseconds.
OMNIPILOT_NAV_TIMEOUT_MS=25000
