+class StepBudget {
+  private timer?: NodeJS.Timeout;
+  private startedAt = 0;
+  private readonly listener = (paused: boolean) => (paused ? this.stop() : this.start());
+
+  constructor(
+    private remainingMs: number,
+    private readonly run: RunState,
+    private readonly onExpire: () => void,
